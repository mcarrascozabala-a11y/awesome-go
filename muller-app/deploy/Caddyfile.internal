# Factory network only: Caddy signs its own certificate. Each tablet must
# trust Caddy's root certificate once, downloadable from http://<server>/certificat
{
	# Browsers send no server name when the address is an IP: use this one.
	default_sni {$MULLER_SITE}
}
http://{$MULLER_SITE} {
	handle /certificat {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=muller-ca.crt"
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}

https://{$MULLER_SITE} {
	tls internal
	encode gzip
	reverse_proxy app:8080
}
