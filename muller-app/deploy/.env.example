# Copy to .env and fill in.

# Address the tablets will open: the server's network name or IP
# (e.g. muller-srv.local or 192.168.1.50), or a public domain name.
MULLER_SITE=192.168.1.50

# "internal" = factory network only (self-signed, install the certificate on
# each tablet once). "public" = public domain name with a free certificate.
MULLER_HTTPS=internal

# Shared password typed once on each tablet. Pick a long one.
MULLER_PASSWORD=change-me
